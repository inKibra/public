      "@happy-dom/global-registrator": "^20.0.10",
      "ioredis": "^5.4.1"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.1",
    "@types/bun": "catalog:",
    "knip": "^5.81.0",
    "nx": "^20.8.2",
    "typescript": "catalog:"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "bcrypt",
    "nx"
  ],
  "overrides": {
    "esbuild": "0.25.10",
    "@vanilla-extract/integration": "8.0.6"
  }
}
