{
  "name": "@inkibra/storybook",
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "bun": "v1.3.0"
  },
  "description": "AST-based storybook discovery and testing utilities",
  "main": "./index.ts",
  "types": "./index.ts",
  "license": "SEE LICENSE",
  "exports": {
    ".": "./index.ts",
